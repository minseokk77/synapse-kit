{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["compiler/**/*", "memory/**/*", "index.ts"],
  "exclude": ["tests/**/*", "examples/**/*", "dist/**/*"]
}
