{
  "name": "synapse-kit",
  "version": "0.2.3",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "description": "AI-Native Unified Twin-Core: Polyglot Compiler Engine & Causal Memory 2.0 Brain for Monorepos and Agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synapse": "./dist/compiler/cli.js",
    "synapse-kit": "./dist/compiler/cli.js",
    "synapse-memory": "./dist/memory/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    }
  },
  "workspaces": [
    "compiler",
    "memory",
    "db"
  ],
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build:compiler": "cd compiler && bun run build",
    "build:memory": "cd memory && bun run build",
    "build:db": "cd db && bun run build",
    "build:root": "bun build compiler/cli.ts --outfile dist/compiler/cli.js --target bun && bun build memory/cli.ts --outfile dist/memory/cli.js --target bun && bun build index.ts --outfile dist/index.js --target bun && bun build compiler/index.ts --outfile dist/compiler/index.js --target bun && bun build memory/index.ts --outfile dist/memory/index.js --target bun && bun build db/index.ts --outfile dist/db/index.js --target bun && tsc -p tsconfig.build.json",
    "build": "bun run build:root && bun run build:compiler && bun run build:memory && bun run build:db",
    "prepublishOnly": "bun run build",
    "start": "bun run compiler/cli.ts",
    "check": "bun run compiler/cli.ts check",
    "test": "bun test",
    "memory": "bun run memory/cli.ts",
    "memory:query": "bun run memory/cli.ts query",
    "memory:list": "bun run memory/cli.ts list",
    "memory:audit": "bun run memory/cli.ts audit",
    "memory:serve": "bun run memory/cli.ts serve",
    "memory:bench": "bun run memory/cli.ts benchmark",
    "memory:peer": "bun run memory/cli.ts peer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minseokk77/synapse-kit.git"
  },
  "homepage": "https://github.com/minseokk77/synapse-kit#readme",
  "bugs": {
    "url": "https://github.com/minseokk77/synapse-kit/issues"
  },
  "keywords": [
    "tauri",
    "compiler",
    "verification",
    "rust",
    "svelte",
    "typescript",
    "ai-native",
    "causal-memory",
    "bun"
  ],
  "author": "Vesper",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.6.3"
  }
}
