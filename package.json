{
  "name": "synapse-kit",
  "version": "0.2.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "AI-Native Unified Compiler, Linter & Verification Framework for Tauri and Full-Stack Apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synapse": "./dist/cli.js",
    "synapse-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build:bundle": "bun build src/cli.ts --outfile dist/cli.js --target bun && bun build src/index.ts --outfile dist/index.js --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:bundle && bun run build:types",
    "prepublishOnly": "bun run build",
    "start": "bun run src/cli.ts",
    "check": "bun run src/cli.ts check",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minseokk77/synapse-kit.git"
  },
  "homepage": "https://github.com/minseokk77/synapse-kit#readme",
  "bugs": {
    "url": "https://github.com/minseokk77/synapse-kit/issues"
  },
  "keywords": [
    "tauri",
    "compiler",
    "verification",
    "rust",
    "svelte",
    "typescript",
    "ai-native",
    "bun"
  ],
  "author": "Vesper",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.6.3"
  }
}
