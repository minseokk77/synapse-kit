{
  "name": "synapse-kit",
  "version": "0.2.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "AI-Native Unified Compiler, Linter & Verification Framework for Tauri and Full-Stack Apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synapse": "./dist/compiler/cli.js",
    "synapse-kit": "./dist/compiler/cli.js",
    "synapse-memory": "./dist/memory/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build:bundle": "bun build compiler/cli.ts --outfile dist/compiler/cli.js --target bun && bun build memory/cli.ts --outfile dist/memory/cli.js --target bun && bun build index.ts --outfile dist/index.js --target bun && bun build compiler/index.ts --outfile dist/compiler/index.js --target bun && bun build memory/index.ts --outfile dist/memory/index.js --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:bundle && bun run build:types",
    "prepublishOnly": "bun run build",
    "start": "bun run compiler/cli.ts",
    "check": "bun run compiler/cli.ts check",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minseokk77/synapse-kit.git"
  },
  "homepage": "https://github.com/minseokk77/synapse-kit#readme",
  "bugs": {
    "url": "https://github.com/minseokk77/synapse-kit/issues"
  },
  "keywords": [
    "tauri",
    "compiler",
    "verification",
    "rust",
    "svelte",
    "typescript",
    "ai-native",
    "causal-memory",
    "bun"
  ],
  "author": "Vesper",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.6.3"
  }
}
