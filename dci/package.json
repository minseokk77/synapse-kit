{
  "name": "synapse-dci",
  "version": "0.1.0",
  "description": "Causal-CoW Dynamic Workspace Expansion (Synapse-DCI) & Native 12-Format Document Ingester (PDF, DOCX, PPTX, XLSX, HWPX, HWP5, HTML, CSV, JSON, YAML, XML, Markdown)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outfile dist/index.js --target bun && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minseokk77/synapse-kit.git",
    "directory": "dci"
  },
  "keywords": [
    "dci",
    "dr-dci",
    "dynamic-workspace",
    "rag-alternative",
    "hwp",
    "hwpx",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "connectome",
    "synapse-kit",
    "bun"
  ],
  "author": "Vesper",
  "license": "MIT",
  "dependencies": {
    "synapse-db": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "typescript": "^5.6.3"
  }
}
